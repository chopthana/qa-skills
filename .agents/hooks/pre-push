#!/usr/bin/env bash
# Refuse the two things a ruleset would refuse on `main`: deleting it, and any
# push that is not a fast-forward (a force-push, amend or rebase of pushed work).
#
# Install in a clone:  ln -sf ../../.agents/hooks/pre-push .git/hooks/pre-push
# Bypass once, knowingly:  PROTECT_MAIN=0 git push …
set -u

PROTECTED="${PROTECT_MAIN_BRANCH:-main}"
[ "${PROTECT_MAIN:-1}" = "0" ] && exit 0

ZERO="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/$PROTECTED" ] || continue

  if [ "$local_sha" = "$ZERO" ]; then
    echo "pre-push: refusing to delete $remote_ref" >&2
    status=1
    continue
  fi

  # A new branch on the remote has nothing to lose.
  [ "$remote_sha" = "$ZERO" ] && continue

  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "pre-push: refusing a non-fast-forward push to $remote_ref" >&2
    echo "          ${remote_sha:0:9} on the remote is not an ancestor of ${local_sha:0:9}:" >&2
    echo "          this would discard commits. Merge or rebase onto it instead." >&2
    status=1
  fi
done

[ "$status" -ne 0 ] && echo "pre-push: set PROTECT_MAIN=0 to override, deliberately." >&2
exit "$status"
